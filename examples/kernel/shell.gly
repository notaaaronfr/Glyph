# Glyph OS shell: an interactive program running on bare metal.
#   glyph run examples/kernel/shell.gly --target kernel
# Type `help` for commands, `exit` to power off. (In QEMU, Ctrl-A then X also quits.)

enum Command {
  Help
  Echo { text: Str }
  Fib { n: Int }
  Uptime
  Sleep { ms: Int }
  Sum { numbers: List[Int] }
  Exit
  Nothing
  Invalid { message: Str }
  Unknown { word: Str }
}

fn parse(line: Str) -> Command {
  let words = split(line, " ")
  let cmd = words[0]
  let rest: List[Str] = []
  let i = 1
  while i < len(words) {
    rest = push(rest, words[i])
    i = i + 1
  }
  if cmd == "" { return Nothing }
  if cmd == "help" { return Help }
  if cmd == "echo" { return Echo { text: join(rest, " ") } }
  if cmd == "uptime" { return Uptime }
  if cmd == "exit" { return Exit }
  if cmd == "fib" {
    if len(rest) != 1 { return Invalid { message: "usage: fib <n>" } }
    match parse_int(rest[0]) {
      Some { value } => {
        if value < 0 or value > 40 { return Invalid { message: "fib needs a number from 0 to 40" } }
        return Fib { n: value }
      }
      None => { return Invalid { message: "not a number: " + rest[0] } }
    }
  }
  if cmd == "sleep" {
    if len(rest) != 1 { return Invalid { message: "usage: sleep <milliseconds>" } }
    match parse_int(rest[0]) {
      Some { value } => {
        if value < 0 or value > 60000 { return Invalid { message: "sleep takes 0 to 60000 ms" } }
        return Sleep { ms: value }
      }
      None => { return Invalid { message: "not a number: " + rest[0] } }
    }
  }
  if cmd == "sum" {
    let nums: List[Int] = []
    for w in rest {
      match parse_int(w) {
        Some { value } => { nums = push(nums, value) }
        None => { return Invalid { message: "not a number: " + w } }
      }
    }
    return Sum { numbers: nums }
  }
  return Unknown { word: cmd }
}

fn fib(n: Int) -> Int
  requires n >= 0 and n <= 40
{
  if n < 2 { return n }
  return fib(n - 1) + fib(n - 2)
}

fn main() uses io, time {
  print("Glyph OS 0.1 - type help to see the commands")
  let running = true
  while running {
    let line = input("glyph> ")
    match parse(line) {
      Help => { print("commands: help, echo <text>, fib <n>, sum <numbers...>, sleep <ms>, uptime, exit") }
      Echo { text } => { print(text) }
      Fib { n } => { print("fib(" + str(n) + ") =", fib(n)) }
      Uptime => { print("up for", now(), "ms") }
      Sleep { ms } => {
        let before = now()
        sleep(ms)
        print("slept", now() - before, "ms (the CPU idled until a timer interrupt woke it)")
      }
      Sum { numbers } => {
        let total = 0
        for x in numbers { total = total + x }
        print("sum =", total)
      }
      Exit => {
        print("powering off")
        running = false
      }
      Nothing => {}
      Invalid { message } => { print(message) }
      Unknown { word } => { print("unknown command:", word, "- type help to see the commands") }
    }
  }
}
